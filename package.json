{
  "name": "gcp-media-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Learn GCP by building a media & broadband analytics platform: a GraphL concept app. Scenes render with @graphlearning/graphl-flow; the app shell is @graphlearning/shell.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-content.mjs && node scripts/check-render.mjs",
    "preview": "vite preview",
    "record": "graphl-record",
    "record:all": "caffeinate -ims graphl-record-all",
    "gen:audio": "graphl-gen-audio",
    "gen:desc": "graphl-gen-desc",
    "thumb": "graphl-thumb",
    "check:spine": "python scripts/spine.py",
    "shots": "node scripts/shots.mjs",
    "gen": "python -m sun_gen",
    "film": "node scripts/film.mjs",
    "thumb:film": "node scripts/thumb-film.mjs"
  },
  "dependencies": {
    "@graphlearning/graphl-flow": "0.11.0",
    "@graphlearning/shell": "1.1.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "playwright": "1.63.0",
    "puppeteer": "^25.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
